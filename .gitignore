node_modules/

# Secrets - never commit environment files
.env
.env.*
!.env.example

# Generated telemetry and learning data (large, runtime-generated)
stats/gameTelemetry.json
stats/aiHardTelemetry.json
stats/aiLearningProfile.json
stats/humanPlayData.json

# Persisted in-progress games (restart recovery)
stats/activeGames.json

# Per-guild settings (runtime)
guildSettings.json

# Global bot-owner settings (runtime)
botSettings.json

# Deck-theme source sheets (large) + render previews; sliced cards + back are committed
assets/themes/*/sheet.png
assets/themes/*/_*.png

# Benchmark output artifacts
stats/benchmark_*.json

# Scheduled trainer runtime artifacts
stats/trainer.log
stats/.trainer.lock
